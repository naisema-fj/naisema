{
  // Shared options. Type-check with `pnpm typecheck`, which runs each project directly:
  // tsconfig.node.json (tooling), tsconfig.cloudflare.json (app + Worker), tests/tsconfig.json.
  "files": [],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  }
}
