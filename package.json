{
  "name": "naisema",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "pnpm typegen && tsc -p tsconfig.node.json && tsc -p tsconfig.cloudflare.json && tsc -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "pnpm build && vitest run",
    "test:e2e": "playwright test",
    "staff:grant": "node scripts/grant-staff-role.mjs",
    "staff:reset-two-factor": "node scripts/reset-staff-two-factor.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/utils": "0.4.2",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~4.1.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
