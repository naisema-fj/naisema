{
  "name": "naisema",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "pnpm typegen && tsc -p tsconfig.node.json && tsc -p tsconfig.cloudflare.json && tsc -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "pnpm build && vitest run",
    "test:e2e": "playwright test",
    "staff:grant": "node scripts/grant-staff.mjs",
    "db:export": "node scripts/export-database.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:files": "node scripts/restore-files.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "lucide-react": "1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.158.0"
  }
}
