// Worker configuration (ADR-0015). The top level is local development and tests; `env.staging`
// and `env.production` are selected at build time with CLOUDFLARE_ENV (docs/handover/runbook.md).
// Everything lives in the one NAISEMA Cloudflare account, created with the Oceania location hint.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naisema-dev",
  "account_id": "79d195146bfff668d5b0e8aa5a6ed28b",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Workers' own per-request invocation logs are off: they record full URLs (search words, preview
  // tokens) and visitors' addresses. The app logs each request itself, redacted (app/lib/log.server.ts).
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  "upload_source_maps": true,
  // Set per environment with `wrangler secret put <NAME> --env <env>`; locally in .dev.vars
  // (scripts/ensure-dev-vars.mjs).
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "PREVIEW_SECRET"] },
  "vars": {
    // Cloudflare's always-passing Turnstile test site key (app/lib/turnstile.ts).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Locally the staff site answers on admin.localhost. Nothing is emailed there: the sign-in page
    // shows the link instead, and tests may name staff with the X-Dev-Staff-Email header (app/lib/staff.server.ts).
    "ADMIN_HOSTNAME": "admin.localhost",
    "EMAIL_FROM": "NAISEMA <no-reply@naisema.com>",
    // Buttondown's own embedded sign-up form (docs/decision-log.md, v1 launch rewrite). Empty: the
    // newsletter says it isn't open yet.
    "NEWSLETTER_FORM_URL": "",
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naisema-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Public forms: at most 5 sends a minute from one address to one form (app/lib/form-guard.server.ts).
  "ratelimits": [{ "name": "FORM_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Images are re-encoded on the way out, which strips their metadata, location included.
  "images": { "binding": "IMAGES" },
  // The one bucket: images, audio, clips and documents, and Rights Record evidence under `evidence/`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "naisema-dev-media" }],
  "env": {
    "staging": {
      "name": "naisema-staging",
      "routes": [
        { "pattern": "staging.naisema.com", "custom_domain": true },
        { "pattern": "admin.staging.naisema.com", "custom_domain": true }
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "ADMIN_HOSTNAME": "admin.staging.naisema.com",
        "EMAIL_FROM": "NAISEMA Staging <no-reply@naisema.com>",
        "NEWSLETTER_FORM_URL": "",
        "ENVIRONMENT": "staging"
      },
      "send_email": [{ "name": "EMAIL" }],
      "secrets": { "required": ["TURNSTILE_SECRET_KEY", "PREVIEW_SECRET", "NOTIFY_EMAILS"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "naisema-v1-staging",
          "database_id": "7d9d0bbc-4b50-444b-914d-bd7563a27de1",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "FORM_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
      "images": { "binding": "IMAGES" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "naisema-staging-media" }]
    },
    "production": {
      "name": "naisema-production",
      "routes": [
        { "pattern": "naisema.com", "custom_domain": true },
        { "pattern": "admin.naisema.com", "custom_domain": true }
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
        "ALLOW_INDEXING": "true",
        "ADMIN_HOSTNAME": "admin.naisema.com",
        "EMAIL_FROM": "NAISEMA <no-reply@naisema.com>",
        "NEWSLETTER_FORM_URL": "",
        "ENVIRONMENT": "production"
      },
      "send_email": [{ "name": "EMAIL" }],
      "secrets": { "required": ["TURNSTILE_SECRET_KEY", "PREVIEW_SECRET", "NOTIFY_EMAILS"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "naisema-v1-production",
          "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [{ "name": "FORM_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }],
      "images": { "binding": "IMAGES" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "naisema-production-media" }]
    }
  }
}
