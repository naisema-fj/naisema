# Copy to .dev.vars for local development (or run `node scripts/ensure-dev-vars.mjs`).
# Cloudflare's always-passing Turnstile test secret (app/lib/turnstile.ts).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Signs preview links (app/lib/preview.server.ts).
PREVIEW_SECRET=replace-with-a-long-random-string
